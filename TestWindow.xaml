<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lunaris — тест кликов" Width="570" Height="400" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" Background="#F9F7FD" FontFamily="Segoe UI" Foreground="#302B40">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Проверь свой ритм" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="Hint" Grid.Row="1" Margin="0,9,0,20" Foreground="#8C7BA2" FontSize="12"/>
    <Border x:Name="Pad" Grid.Row="2" Background="#EEE8FC" BorderBrush="#D3C4F6" BorderThickness="1" CornerRadius="17" Cursor="Hand" AutomationProperties.Name="Площадка для проверки кликов"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="ClickCount" Text="0" FontSize="56" FontWeight="Light" Foreground="#7860E8" HorizontalAlignment="Center"/><TextBlock Text="КЛИКОВ ПОЛУЧЕНО" Foreground="#A18EBF" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
    <Grid Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="Details" Text="Получено на площадке" VerticalAlignment="Center" Foreground="#A097AD" FontSize="10"/><Button x:Name="ResetButton" Content="Сбросить" HorizontalAlignment="Right" Padding="12,6" Background="White" BorderBrush="#E2DAED" Foreground="#7A6A90"/></Grid>
  </Grid>
</Window>

